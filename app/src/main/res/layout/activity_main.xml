<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.nest.kanxue.MainActivity">



    <FrameLayout
        android:id="@+id/SurfaceViewFrame"
        android:layout_width="10dp"
        android:layout_height="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </FrameLayout>

    <Button
        android:id="@+id/stat_file_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="上传文件"
        app:layout_constraintLeft_toLeftOf="parent"
        tools:layout_editor_absoluteX="36dp"
        tools:layout_editor_absoluteY="25dp" />

    <Button
        android:id="@+id/test"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="debu测试，不用点击"
        app:layout_constraintLeft_toRightOf="@id/stat_file_btn"
        app:layout_constraintRight_toRightOf="parent"
 />

    <TextView
        android:id="@+id/uploadStatusText"
        app:layout_constraintTop_toBottomOf="@id/stat_file_btn"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextView"
        tools:layout_editor_absoluteX="39dp"
        tools:layout_editor_absoluteY="115dp" />


    <EditText
        android:id="@+id/pathInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/uploadStatusText"
        android:hint="请输入文件夹路径"
        android:inputType="text" />

    <Button
        android:id="@+id/confirmButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/pathInput"
        android:text="确认路径" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        app:layout_constraintTop_toBottomOf="@id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />









</androidx.constraintlayout.widget.ConstraintLayout>