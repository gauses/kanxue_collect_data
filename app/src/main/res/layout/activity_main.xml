<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fitsSystemWindows="true"
    android:fadeScrollbars="true"
>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/SurfaceViewFrame"
            android:layout_width="10dp"
            android:layout_height="10dp">
        </FrameLayout>


        <com.nest.kanxue.core.fingerprint.SurfaceFingerprint
            android:id="@+id/surfaceFingerprint"
            android:layout_width="1dp"
            android:layout_height="1dp"
            app:layout_constraintLeft_toLeftOf="parent"
            android:visibility="invisible" />


        <Switch
            android:id="@+id/cpu_capture_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="是否抓取CPU文件(默认抓取上传)"
            android:textSize="16sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:checked="true"
            app:layout_constraintTop_toBottomOf="@id/SurfaceViewFrame"
            app:layout_constraintLeft_toLeftOf="parent"
            tools:ignore="MissingConstraints" />

        <Button
            android:id="@+id/stat_file_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上传文件"
            app:layout_constraintTop_toBottomOf="@id/cpu_capture_switch"
            app:layout_constraintLeft_toLeftOf="parent" />


        <Button
            android:id="@+id/stat_data_local_file_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上传/data/local/tmp/文件"
            android:layout_marginLeft="20dp"
            app:layout_constraintTop_toBottomOf="@id/cpu_capture_switch"
            app:layout_constraintLeft_toRightOf="@id/stat_file_btn"
             />


        <Button
            android:id="@+id/test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="debug测试，不用点击"
            app:layout_constraintTop_toBottomOf="@id/stat_file_btn"
            app:layout_constraintLeft_toLeftOf="parent"
            />


        <Button
            android:id="@+id/stop_sensor_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StopSensor"
            app:layout_constraintLeft_toRightOf="@id/test"
            app:layout_constraintBottom_toBottomOf="@+id/test"
            app:layout_constraintRight_toRightOf="parent"
            />


        <TextView
            android:id="@+id/uploadStatusText"
            app:layout_constraintTop_toBottomOf="@id/test"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
             />

        <TextView
            android:id="@+id/checkSensorText"
            app:layout_constraintTop_toBottomOf="@id/uploadStatusText"
            android:textSize="20sp"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="checkSensorText"
            />

        <TextView
            android:id="@+id/copyCPUResult"
            app:layout_constraintTop_toBottomOf="@id/checkSensorText"
            android:textSize="20sp"
            android:textColor="@android:color/holo_red_dark"
            android:layout_marginTop="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="copyCPUResult"
            />

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/pathInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/copyCPUResult"
            android:hint="请输入文件夹路径"
            android:inputType="text" />


        <Button
            android:id="@+id/confirmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/pathInput"
            android:text="确认路径" />



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            app:layout_constraintTop_toBottomOf="@id/confirmButton"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1" />


        <androidx.cardview.widget.CardView
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/recyclerView"
            android:layout_margin="4dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <TextView
                android:id="@+id/file_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:textSize="16sp" />
        </androidx.cardview.widget.CardView>








    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
